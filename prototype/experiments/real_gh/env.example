# Copy to env.local (gitignored) or export in shell. VALUES never committed.
JOINT_OWNER=zhekui-hub
JOINT_LAB_REPO=joint-ci-lab
JOINT_DRIVER_REPO=joint-ci-driver
JOINT_SYNAPSE_REPO=joint-ci-synapse
JOINT_SIM_REPO=joint-ci-sim

# Credential *names* — put secrets in keychain / CI secrets store:
# JOINT_GH_TOKEN
# JOINT_APP_ID
# JOINT_APP_INSTALLATION_ID
# JOINT_APP_PRIVATE_KEY_PATH

JOINT_DRY_RUN=1
JOINT_LABEL=joint-ci
JOINT_BRANCH_PREFIX=exp/ci-
